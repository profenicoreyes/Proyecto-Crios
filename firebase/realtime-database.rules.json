{
  "rules": {
    ".read": false,
    ".write": false,
    "liveRoomSignals": {
      "$roomId": {
        ".read": "auth != null && $roomId.length > 0 && $roomId.length <= 160",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $roomId.length > 0 && $roomId.length <= 160",
          ".validate": "newData.hasChildren(['type', 'eventId', 'emittedAt'])",
          "type": {
            ".validate": "newData.isString() && newData.val() === 'presence-change'"
          },
          "eventId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
          },
          "emittedAt": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
